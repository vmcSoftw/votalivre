DATABASE_URL=postgresql://usuario:senha@host/database?sslmode=require
APP_ORIGIN=http://localhost:3000
# npm run keys -> copie os valores hex gerados; não publique no Git.
BALLOT_ENCRYPTION_KEY=COLE_AQUI_64_CARACTERES_HEXADECIMAIS
TOKEN_PEPPER=COLE_AQUI_64_CARACTERES_HEXADECIMAIS
VOTER_PIN_PEPPER=COLE_AQUI_64_CARACTERES_HEXADECIMAIS
LOGIN_RATE_SECRET=COLE_AQUI_64_CARACTERES_HEXADECIMAIS
MFA_ENCRYPTION_KEY=COLE_AQUI_64_CARACTERES_HEXADECIMAIS
# Chave AES exclusiva de custódia temporária dos PINs de emissão
ISSUANCE_ENCRYPTION_KEY=COLE_AQUI_64_CARACTERES_HEXADECIMAIS
# Identificadores irreversíveis por HMAC e nomes cifrados no cadastro de aptos
ROSTER_PROTECTION_KEY=COLE_AQUI_64_CARACTERES_HEXADECIMAIS

# Obrigatório para publicar resultados: mapa de IDs -> hashes públicos pinados antes da votação.
# NÃO incluir as chaves privadas. Guardar cópia externa, assinada e entregue à comissão.
ELECTION_TRUST_ANCHORS_JSON={}
